<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Desktop app: WinForms window hosting WebView2, with the hardware bridge and
         UI server in-process. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FanBridge</RootNamespace>
    <AssemblyName>AutomaticFanTuner</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Driver access (PawnIO via LibreHardwareMonitor) requires elevation. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web UI ships inside the app and is served from the in-process listener. -->
    <Content Include="..\public\**\*" Link="public\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
